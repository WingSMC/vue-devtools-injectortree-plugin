{
  "name": "vue-devtools-injectortree",
  "version": "0.1.0",
  "description": "Vue DevTools plugin that visualizes provide/inject relationships as an injector tree",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "devtools",
    "provide",
    "inject",
    "injector-tree"
  ],
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.1.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.4.0",
    "@vue/language-core": "^3.1.8",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue": "^3.4.0"
  }
}
